[
  {
    "name": "folded-lookbehind",
    "grammars": [
      {
        "scopeName": "source.folded",
        "patterns": [
          {"begin": "(?<=(?i:k))([A-Z])", "end": "\\1", "name": "meta.block.$1", "beginCaptures": {"1": {"name": "punctuation.begin"}}, "endCaptures": {"0": {"name": "punctuation.end"}}},
          {"begin": "^>([ks])", "while": "^.(?<=(?i:\\1))>", "name": "meta.while", "whileCaptures": {"0": {"name": "punctuation.while"}}},
          {"include": "#word"},
          {"include": "source.folded.external#word"},
          {"match": "(?<=(?i:s))y", "name": "losing.same-position"}
        ],
        "repository": {"word": {"match": "(?<=(?i:(k|s)))(x)", "captures": {"2": {"name": "entity.folded"}}}},
        "injections": {"L:source.folded": {"patterns": [{"match": "(?<=(?i:s))y", "name": "injected.left"}]}}
      },
      {"scopeName": "source.folded.external", "patterns": [], "repository": {"word": {"match": "(?<=(?i:K))z", "name": "constant.external"}}}
    ],
    "sources": ["🛰Kx ſx kx kz ſy\r\n\nKQ body\n中Q\n>k\nK>tail\nstop\n", "", "\n", "Kx"]
  },
  {
    "name": "literal-scope-punctuation",
    "grammars": [{"scopeName": "source.punctuation", "patterns": [
      {"match": "x", "name": ".entity..name.  keyword.control"},
      {"match": "y", "name": "."},
      {"match": "(\\.+word\\.+)", "name": "meta.$1"},
      {"match": "z", "name": "\tmeta"},
      {"match": "w", "name": ""}
    ]}],
    "sources": ["xy ..word.. zw\n"]
  },
  {
    "name": "dormant-capture-observability",
    "grammars": [{"scopeName": "source.dormant", "patterns": [
      {"begin": "(?<x>a)?(?(<x>)b|c)d", "end": "\\1;", "name": "meta.$1", "beginCaptures": {"1": {"name": "entity.dormant", "patterns": [{"match": ".", "name": "invalid.dormant"}]}}, "patterns": [{"match": "!", "name": "keyword.inside"}]},
      {"match": "!", "name": "keyword.outside"}
    ]}],
    "sources": ["🛰cd!;!\n", "abd!a;!\r\n", "cd\n!;!\n"]
  },
  {
    "name": "dormant-while-observability",
    "grammars": [{"scopeName": "source.dormant", "patterns": [
      {"begin": "^(?<x>a)?(?(<x>)b|c)d", "while": "^\\1>", "name": "meta.$1", "beginCaptures": {"1": {"name": "entity.dormant", "patterns": [{"match": ".", "name": "invalid.dormant"}]}}, "whileCaptures": {"0": {"name": "punctuation.while"}}, "patterns": [{"match": "!", "name": "keyword.inside"}]},
      {"match": "!", "name": "keyword.outside"}
    ]}],
    "sources": ["cd\n>!\nstop\nabd\na>!\nstop\n"]
  },
  {
    "name": "lookahead-capture-outside-match",
    "grammars": [
      {
        "scopeName": "source.outside",
        "patterns": [
          {
            "match": "T\\b(?=\\s*+(\\w+)(?=(x?)\\())",
            "name": "storage.type",
            "captures": {
              "1": {
                "name": "entity.skipped"
              },
              "2": {
                "patterns": [
                  {
                    "match": "x",
                    "name": "invalid.never"
                  }
                ]
              }
            }
          },
          {
            "match": "U(?=(-)(x?))",
            "name": "storage.type",
            "captures": {
              "1": {
                "name": "punctuation.dash"
              },
              "2": {
                "patterns": [
                  {
                    "match": "x",
                    "name": "invalid.never"
                  }
                ]
              }
            }
          },
          {
            "match": "(\\w+)(\\()",
            "captures": {
              "1": {
                "name": "entity.call"
              },
              "2": {
                "name": "punctuation.open"
              }
            }
          }
        ]
      }
    ],
    "sources": [
      "T f(v)\nU-g(v)\n"
    ]
  },
  {
    "name": "outside-capture-resumes-at-match-end",
    "grammars": [
      {
        "scopeName": "source.resume",
        "patterns": [
          {
            "match": "int(?=( ))",
            "name": "storage.type",
            "captures": {
              "1": {
                "patterns": [
                  {
                    "match": "x",
                    "name": "invalid.never"
                  }
                ],
                "name": "punctuation.space"
              }
            }
          },
          {
            "match": "__a\\(",
            "name": "support.attribute"
          },
          {
            "match": "\\s*+(\\w+)(\\()",
            "captures": {
              "1": {
                "name": "entity.call"
              },
              "2": {
                "name": "punctuation.open"
              }
            }
          }
        ]
      }
    ],
    "sources": [
      "int __a(v)\n"
    ]
  },
  {
    "name": "empty-match-lookahead-capture",
    "grammars": [
      {
        "scopeName": "source.emptycap",
        "patterns": [
          {"match": "(?=(zz))", "captures": {"1": {"name": "empty.look"}}},
          {"match": "b", "name": "letter.b"}
        ]
      }
    ],
    "sources": ["zz", "a zz b", "zzb"]
  },
  {
    "name": "nested-captures-past-match-end",
    "grammars": [
      {
        "scopeName": "source.nestedcap",
        "patterns": [
          {"match": "x(?=((a)b))", "name": "keyword.x", "captures": {"1": {"name": "outer"}, "2": {"name": "inner"}}},
          {"match": "(?=(c))(?=(cd))", "captures": {"1": {"name": "c1"}, "2": {"name": "c2"}}},
          {"match": "(?=((e)f))", "captures": {"1": {"name": "outer.empty"}, "2": {"name": "inner.empty"}}}
        ]
      }
    ],
    "sources": ["xab", "cd", "ef", "xab cd"]
  },
  {
    "name": "recursive-empty-begin",
    "grammars": [
      {
        "scopeName": "source.emptybegin",
        "patterns": [{"include": "#r"}],
        "repository": {
          "r": {"begin": "(?=(zz))", "end": "b", "name": "meta.r", "patterns": [{"include": "#r"}]}
        }
      }
    ],
    "sources": ["zz\nzz\nzzb", "a zz b zz"]
  },
  {
    "name": "recursive-empty-begin-in-capture",
    "grammars": [
      {
        "scopeName": "source.emptybegin.capture",
        "patterns": [
          {"match": "<(zz(?:b|zz)*)>", "name": "meta.tag", "captures": {"1": {"patterns": [{"include": "#r"}]}}}
        ],
        "repository": {
          "r": {"begin": "(?=(zz))", "end": "b", "name": "meta.r", "patterns": [{"include": "#r"}]}
        }
      }
    ],
    "sources": ["<zz> <zzbzz>", "<zzzz>"]
  }
]
