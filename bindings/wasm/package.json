{
  "name": "syntaxmate",
  "version": "0.2.1",
  "description": "Fast TextMate syntax highlighting to HTML, ANSI, or token arrays, compiled to WebAssembly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phongndo/syntaxmate.git",
    "directory": "bindings/wasm"
  },
  "keywords": ["syntax-highlighting", "textmate", "highlighter", "wasm"],
  "type": "module",
  "sideEffects": ["./lib/node.js"],
  "exports": {
    ".": {
      "node": {
        "types": "./lib/node.d.ts",
        "default": "./lib/node.js"
      },
      "default": {
        "types": "./lib/browser.d.ts",
        "default": "./lib/browser.js"
      }
    },
    "./grammars.bundle": "./grammars.bundle",
    "./syntaxmate.wasm": "./dist/syntaxmate_bg.wasm",
    "./package.json": "./package.json"
  },
  "types": "./lib/node.d.ts",
  "files": [
    "dist/syntaxmate.js",
    "dist/syntaxmate_bg.wasm",
    "lib/",
    "grammars.bundle",
    "LICENSE",
    "third-party/"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "npx -y --package=typescript@5.9 tsc -p test/types",
    "bench": "node bench/bench.mjs"
  }
}
