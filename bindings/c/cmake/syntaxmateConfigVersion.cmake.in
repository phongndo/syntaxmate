# Installed as <prefix>/lib/cmake/syntaxmate/syntaxmateConfigVersion.cmake.
# Before 1.0 the C ABI may change between minor versions, so a request is
# compatible only with the same major.minor and an equal or newer patch.
# From 1.0, any equal or newer version with the same major is compatible.
set(PACKAGE_VERSION "@VERSION@")

if(PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
  string(REGEX MATCH "^([0-9]+)\\.([0-9]+)" _syntaxmate_have "${PACKAGE_VERSION}")
  set(_syntaxmate_major "${CMAKE_MATCH_1}")
  set(_syntaxmate_minor "${CMAKE_MATCH_2}")
  if(NOT PACKAGE_FIND_VERSION_MAJOR EQUAL _syntaxmate_major)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
  elseif(_syntaxmate_major EQUAL 0 AND NOT PACKAGE_FIND_VERSION_MINOR EQUAL _syntaxmate_minor)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
  else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
      set(PACKAGE_VERSION_EXACT TRUE)
    endif()
  endif()
  unset(_syntaxmate_have)
  unset(_syntaxmate_major)
  unset(_syntaxmate_minor)
endif()

